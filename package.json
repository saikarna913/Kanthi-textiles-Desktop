{
"name": "kanthi-textiles",
"version": "2.0.0",
"description": "Kanthi Textiles — Advanced Analytics & Inventory Platform",

"main": "electron/main.js",

"homepage": "./",

"author": "Kanthi Textiles",

"scripts": {
  "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
  "react-start": "react-scripts start",
  "electron-start": "cross-env NODE_ENV=development electron .",

"build": "npm run react-build && npm run electron-build",

"react-build": "react-scripts build",

"electron-build": "electron-builder --win",

"dist": "electron-builder",

"postinstall": "electron-builder install-app-deps"


},

"build": {
"appId": "com.kanthi.textiles",


"productName": "Kanthi Textiles Analytics",

"directories": {
  "output": "dist"
},

"files": [
  "build/**/*",
  "electron/**/*",
  "node_modules/**/*",
  "package.json"
],

"extraMetadata": {
  "main": "electron/main.js"
},

"asar": true,

"win": {
  "target": [
    "nsis"
  ]
},

"nsis": {
  "oneClick": false,

  "allowToChangeInstallationDirectory": true,

  "createDesktopShortcut": true,

  "shortcutName": "Kanthi Textiles"
}


},

"dependencies": {
"better-sqlite3": "^11.3.0",

"xlsx": "^0.18.5",

"react": "^18.3.1",

"react-dom": "^18.3.1",

"react-router-dom": "^6.28.0",

"react-dropzone": "^14.3.5",

"react-hot-toast": "^2.4.1",

"recharts": "^2.13.3",

"framer-motion": "^11.12.0",

"lucide-react": "^0.460.0",

"clsx": "^2.1.1",

"date-fns": "^4.1.0"


},

"devDependencies": {
"electron": "33.4.11",

"electron-builder": "^25.1.8",

"concurrently": "^9.1.0",

"cross-env": "^7.0.3",

"wait-on": "^8.0.1",

"react-scripts": "5.0.1",

"tailwindcss": "^3.4.15",

"postcss": "^8.4.49",

"autoprefixer": "^10.4.20"


},

"browserslist": {
"production": [
"last 1 electron version"
],

"development": [
  "last 1 electron version"
]


}
}
