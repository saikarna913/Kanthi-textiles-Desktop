{
  "name": "kanthi-textiles",
  "version": "2.0.0",
  "description": "Kanthi Textiles — Advanced Analytics & Inventory Platform",
  "main": "electron/main.js",
  "homepage": "./",
  "author": "Kanthi Textiles",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "react-start": "react-scripts start",
    "electron-start": "cross-env NODE_ENV=development electron .",
    "build": "npm run react-build && npm run electron-build",
    "react-build": "react-scripts build",
    "electron-build": "electron-builder --win",
    "dist": "electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3 -v 33.2.0"
  },
  "build": {
    "appId": "com.kanthi.textiles",
    "productName": "Kanthi Textiles Analytics",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kanthi Textiles"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "asar": true
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.15",
    "wait-on": "^8.0.1"
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
